<?xml version="1.0"?>
<!-- Sinh tự động bởi scripts/generate_world_and_map.py - ĐỪNG sửa tay, hãy sửa script.
     Tên world BẮT BUỘC là "warehouse": bridge của turtlebot4_ignition_bringup dùng tên này
     trong các topic /world/warehouse/model/... (nếu đổi, camera/lidar sẽ không lên ROS). -->
<sdf version="1.6">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.70 0.60 1</ambient><diffuse>0.75 0.70 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>0.0 3.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 2.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0.0 -3.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.4 0.2 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 2.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>4.1 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.0 2.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-4.1 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 6.0 2.0</size></box></geometry>
          <material><ambient>0.92 0.92 0.9 1</ambient><diffuse>0.92 0.92 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table">
      <static>true</static>
      <pose>1.8 1.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.8 0.75</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.8 0.75</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_west">
      <static>true</static>
      <pose>-3.75 1.2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 2.0 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 2.0 1.8</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_north">
      <static>true</static>
      <pose>0.5 2.75 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.4 1.4</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.4 1.4</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="sofa">
      <static>true</static>
      <pose>-2.4 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.8 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.8 0.5</size></box></geometry>
          <material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="cabinet">
      <static>true</static>
      <pose>3.7 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.2 1.0</size></box></geometry>
          <material><ambient>0.7 0.7 0.65 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <name>person_1</name>
      <pose>-1.2 1.0 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
    </include>
    <include>
      <name>chair_1</name>
      <pose>1.8 0.2 0 0 0 1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
    </include>
    <include>
      <name>chair_2</name>
      <pose>-3.0 -0.5 0 0 0 0.0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
    </include>
    <include>
      <name>hydrant_1</name>
      <pose>3.4 2.4 0 0 0 0.0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
    </include>
  </world>
</sdf>
