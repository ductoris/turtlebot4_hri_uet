<?xml version='1.0' encoding='utf-8'?>
<sdf version='1.7'>
  <world name='warehouse'>
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name='ignition::gazebo::systems::Physics' filename='libignition-gazebo-physics-system.so'/>
    <plugin name='ignition::gazebo::systems::UserCommands' filename='libignition-gazebo-user-commands-system.so'/>
    <plugin name='ignition::gazebo::systems::SceneBroadcaster' filename='libignition-gazebo-scene-broadcaster-system.so'/>

    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.6 0.7 0.8 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!-- Office Walls (10m x 8m outer boundary, divided into 3 rooms + central hallway) -->
    <!-- Mọi bức tường đều có friction mu=0.01 để robot lướt êm nếu chạm, không bao giờ kẹt dính -->
    <model name='office_walls'>
      <static>true</static>

      <!-- Outer North Wall (y = 4.0) -->
      <link name='wall_north'>
        <pose>0 4.0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Outer South Wall (y = -4.0) -->
      <link name='wall_south'>
        <pose>0 -4.0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>10.0 0.15 1.0</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Outer West Wall (x = -5.0) -->
      <link name='wall_west'>
        <pose>-5.0 0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Outer East Wall (x = 5.0) -->
      <link name='wall_east'>
        <pose>5.0 0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 8.0 1.0</size></box></geometry>
          <material><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Internal Wall: divides Room A and Room B (y = 0.0, x from -5.0 to -1.2) -->
      <link name='wall_ab_divider'>
        <pose>-3.1 0.0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>3.8 0.15 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>3.8 0.15 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- Internal West Divider: separates Room A & B from Hallway (at x = -1.2) -->
      <!-- Door A mở rộng 1.30m tại y in [1.35, 2.65] (tâm y = 2.0) -->
      <!-- Door B mở rộng 1.30m tại y in [-2.65, -1.35] (tâm y = -2.0) -->
      <link name='wall_west_top'>
        <pose>-1.2 3.325 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 1.35 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 1.35 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name='wall_west_mid'>
        <pose>-1.2 0.0 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 2.70 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 2.70 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name='wall_west_bot'>
        <pose>-1.2 -3.325 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 1.35 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 1.35 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <!-- Internal East Divider: separates Room C from Hallway (at x = 1.2) -->
      <!-- Door C mở rộng 1.30m tại y in [-0.65, 0.65] (tâm y = 0.0) -->
      <link name='wall_east_top'>
        <pose>1.2 2.325 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name='wall_east_bot'>
        <pose>1.2 -2.325 0.5 0 0 0</pose>
        <collision name='col'>
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.15 3.35 1.0</size></box></geometry>
          <material><diffuse>0.6 0.65 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM A (Phòng học): Bàn và ghế bố trí thoáng, chừa lối đi thẳng từ cửa y=2.0 -->
    <model name='room_a_table_1'>
      <static>true</static>
      <pose>-3.3 2.8 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='room_a_chair_1'>
      <static>true</static>
      <pose>-3.3 3.4 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='room_a_table_2'>
      <static>true</static>
      <pose>-3.3 1.0 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM B (Phòng thí nghiệm): Bàn lab đặt sát góc nam, hoàn toàn giải phóng lối vào cửa y=-2.0 -->
    <model name='room_b_lab_bench'>
      <static>true</static>
      <pose>-3.3 -2.8 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>1.2 0.6 0.7</size></box></geometry>
          <material><diffuse>0.3 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='room_b_box_1'>
      <static>true</static>
      <pose>-4.0 -1.0 0.25 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><diffuse>0.8 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM C (Phòng họp / Kho): Bàn họp và kệ chứa đồ bố trí thoáng, lối vào cửa y=0.0 thông suốt -->
    <model name='room_c_meeting_table'>
      <static>true</static>
      <pose>3.2 1.5 0.35 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><cylinder><radius>0.6</radius><length>0.7</length></cylinder></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><cylinder><radius>0.6</radius><length>0.7</length></cylinder></geometry>
          <material><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='room_c_storage_box'>
      <static>true</static>
      <pose>3.5 -2.5 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='col'>
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface>
        </collision>
        <visual name='vis'>
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
